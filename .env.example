APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WORKBENCH_ROOT=D:/aipm/demo
DATABASE_URL=sqlite:///D:/aipm/demo/storage/app.db
MOCK_AI_DELAY_MS=250
AI_PROVIDER=mock
# 当前版本默认不发起任何模型网络请求。实现兼容 Provider 后再配置以下三项：
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=replace-me
# AI_MODEL=replace-me
# 浏览器缓存、TEMP、pip 和字节码路径由 scripts/runtime-env.ps1 强制定向到 D 盘。
