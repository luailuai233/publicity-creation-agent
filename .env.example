APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WORKBENCH_ROOT=.
MOCK_AI_DELAY_MS=250
AI_PROVIDER=mock
MAX_REQUEST_BODY_BYTES=26214400
# 默认使用本地 Mock。切换兼容 OpenAI Chat Completions 的服务时配置以下项目：
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=replace-me
# AI_MODEL=replace-me
# AI_VISION_MODEL=replace-me-if-needed
# AI_CONNECT_TIMEOUT_SECONDS=10
# AI_READ_TIMEOUT_SECONDS=120
# AI_WRITE_TIMEOUT_SECONDS=30
# AI_POOL_TIMEOUT_SECONDS=10
# AI_MAX_CONNECTIONS=10
# Windows 包装脚本会覆盖 WORKBENCH_ROOT，并把缓存、TEMP、SQLite、上传和导出定向到仓库目录。
